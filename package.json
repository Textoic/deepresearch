{
  "name": "@textoic/deepresearch",
  "version": "0.1.0",
  "description": "Budget-bounded, evidence-led research for Node.js applications.",
  "keywords": [
    "research",
    "llm",
    "agent",
    "citations",
    "searxng",
    "ollama",
    "openrouter"
  ],
  "homepage": "https://github.com/Textoic/deepresearch#readme",
  "bugs": {
    "url": "https://github.com/Textoic/deepresearch/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Textoic/deepresearch.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "budget-research": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node tools/lint.mjs && tsc -p tsconfig.json && tsx --test test/*.test.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "tsc -p tsconfig.json && node dist/cli.js",
    "lint": "node tools/lint.mjs",
    "prepare": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
