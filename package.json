{
  "name": "budget-researcher",
  "version": "0.1.0",
  "private": true,
  "description": "Budget-bounded, evidence-led research for Node.js applications.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "budget-research": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && tsx --test test/*.test.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "tsc -p tsconfig.json && node dist/cli.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  },
  "license": "MIT"
}
